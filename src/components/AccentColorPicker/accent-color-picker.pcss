.accent-color-picker {
  margin: 0;

  &__label {
    color: var(--muted-text-color);
    font-size: .78rem;
    font-weight: 650;
  }

  &__trigger,
  &__option {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-color);
    background: var(--surface-color);
    cursor: pointer;
  }

  &__trigger {
    width: 32px;
    height: 32px;
    padding: 0;
    border-radius: var(--border-radius-d);

    &:focus-visible {
      outline: 2px solid var(--accent-color);
      outline-offset: 2px;
    }

    > span {
      width: 13px;
      height: 13px;
      border-radius: 50%;
      box-shadow: 0 0 0 2px var(--surface-color), 0 0 0 3px var(--text-color);
    }
  }

  &__palette {
    position: fixed;
    z-index: 35;
    display: flex;
    flex-direction: column;
    gap: var(--spacer-c);
    width: 248px;
    padding: var(--spacer-d);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-d);
    background: var(--surface-color);
    box-shadow: var(--surface-shadow);
    animation: accent-color-picker-show .16s ease both;
  }

  &__options {
    display: flex;
    gap: var(--spacer-c);
  }

  &__option {
    width: 44px;
    height: 44px;
    padding: 0;
    border-radius: var(--border-radius-c);

    > span {
      width: 20px;
      height: 20px;
      border-radius: 50%;
      transition: transform .18s ease, box-shadow .18s ease;
    }

    &--selected {
      border-color: var(--accent-color);
      background: color-mix(in srgb, var(--accent-color) 12%, transparent);
      box-shadow: inset 0 0 0 1px var(--accent-color), 0 0 0 2px color-mix(in srgb, var(--accent-color) 25%, transparent);
    }

    &:focus-visible {
      outline: 2px solid var(--accent-color);
      outline-offset: 2px;
    }
  }

  &--menu {
    display: grid;
    grid-template-columns: repeat(5, 44px);
    gap: var(--spacer-c);

    .accent-color-picker__label {
      grid-column: 1 / -1;
    }
  }
}

@keyframes accent-color-picker-show {
  from { opacity: 0; transform: translateY(-4px) scale(.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@media (prefers-reduced-motion: reduce) {
  .accent-color-picker__palette { animation: none; }
}

@media (pointer: coarse) {
  .accent-color-picker--header .accent-color-picker__trigger {
    width: 44px;
    height: 44px;
  }
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

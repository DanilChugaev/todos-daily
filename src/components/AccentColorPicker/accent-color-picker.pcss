.accent-color-picker {
  display: flex;
  align-items: center;
  gap: var(--spacer-a);
  margin: 0;
  padding: 3px;
  border: 1px solid var(--border-color);
  border-radius: var(--border-radius-d);
  background: var(--surface-color);

  &__option {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    cursor: pointer;
  }

  &__label {
    color: var(--muted-text-color);
    font-size: .78rem;
    font-weight: 650;
  }

  input {
    position: absolute;
    opacity: 0;
  }

  input + span {
    width: 10px;
    height: 10px;
    border: 1px solid transparent;
    border-radius: 50%;
    transition: transform .18s ease, box-shadow .18s ease;
  }

  input:checked + span {
    transform: scale(1.1);
    box-shadow: 0 0 0 1px var(--surface-color), 0 0 0 3px var(--text-color);
  }

  input:focus-visible + span {
    outline: 2px solid var(--accent-color);
    outline-offset: 2px;
  }

  &--menu {
    display: grid;
    grid-template-columns: repeat(5, 44px);
    gap: var(--spacer-c);
    padding: 0;
    border: 0;
    background: transparent;

    .accent-color-picker__label {
      grid-column: 1 / -1;
    }

    .accent-color-picker__option {
      width: 44px;
      height: 44px;
      border: 1px solid var(--border-color);
      border-radius: var(--border-radius-c);

      &--selected {
        border-color: var(--accent-color);
        background: color-mix(in srgb, var(--accent-color) 12%, transparent);
        box-shadow: inset 0 0 0 1px var(--accent-color), 0 0 0 2px color-mix(in srgb, var(--accent-color) 25%, transparent);
      }
    }

    input + span {
      width: 20px;
      height: 20px;
    }
  }
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

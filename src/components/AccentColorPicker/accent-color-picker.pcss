.accent-color-picker {
  display: flex;
  align-items: center;
  gap: var(--spacer-a);
  margin: 0;
  padding: 3px;
  border: 1px solid var(--border-color);
  border-radius: var(--border-radius-d);
  background: var(--surface-color);

  &__option {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    cursor: pointer;
  }

  input {
    position: absolute;
    opacity: 0;
  }

  input + span {
    width: 10px;
    height: 10px;
    border: 1px solid transparent;
    border-radius: 50%;
    transition: transform .18s ease, box-shadow .18s ease;
  }

  input:checked + span {
    transform: scale(1.1);
    box-shadow: 0 0 0 1px var(--surface-color), 0 0 0 3px var(--text-color);
  }

  input:focus-visible + span {
    outline: 2px solid var(--accent-color);
    outline-offset: 2px;
  }
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

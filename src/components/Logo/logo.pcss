.logo {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    position: relative;

    &__todos {
        font-size: 1.5rem;
    }

    &__daily {
        font-size: 1rem;
    }

    &__version {
        position: absolute;
        top: 0;
        left: calc(100% + 0.5rem);
        font-size: 0.6rem;
        color: var(--task-info-text-color);
    }
}

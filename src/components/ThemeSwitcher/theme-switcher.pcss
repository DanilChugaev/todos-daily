.theme-switcher {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    margin: 0;
    padding: var(--spacer-a);
    border: none;
    position: relative;
    isolation: isolate;

    &__legend {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    &__label {
        grid-column: 1 / -1;
        color: var(--muted-text-color);
        font-size: .78rem;
        font-weight: 650;
    }

    &__radio {
        -webkit-appearance: none;
        appearance: none;
        margin: 0;
        width: 28px;
        height: 28px;
        cursor: pointer;
        background-position: center;
        background-repeat: no-repeat;
        background-size: 20px;
        transition: filter 0.1s ease-in;
        filter: var(--theme-switcher-radio-filter);

        &:checked {
            filter: var(--theme-switcher-radio-filter-checked);
        }

        &:focus {
            outline: none;
        }

        &:focus-visible {
            & ~ .theme-switcher__status {
                box-shadow: 0 0 0 2px var(--accent-color);
            }
        }

        &--light {
            background-image: url('/src/icons/light.svg');

            &:checked {
                & ~ .theme-switcher__status {
                    background-position: left 2px center;
                }
            }
        }

        &--system {
            background-image: url('/src/icons/system.svg');

            &:checked {
                & ~ .theme-switcher__status {
                    background-position: center center;
                }
            }
        }

        &--dark {
            background-image: url('/src/icons/dark.svg');

            &:checked {
                & ~ .theme-switcher__status {
                    background-position: right 2px center;
                }
            }
        }
    }

    &__status {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        z-index: -1;
        box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.2);
        border-radius: var(--border-radius-d);
        background-color: rgba(255, 255, 255, 0.5);
        background-repeat: no-repeat;
        background-image: url('/src/icons/status.svg');
        background-size: 28px;
        background-position: center;
        transition: background-position 0.15s ease-in;
        filter: var(--theme-switcher-status-filter);
    }

    &--menu {
        grid-template-columns: repeat(3, 44px);
        gap: var(--spacer-c);
        padding: 0;

        .theme-switcher__radio {
            width: 44px;
            height: 44px;
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius-c);
            background-size: 22px;
            filter: var(--theme-switcher-radio-filter);

            &--selected {
                border-color: var(--accent-color);
                background-color: color-mix(in srgb, var(--accent-color) 12%, transparent);
                box-shadow: inset 0 0 0 1px var(--accent-color), 0 0 0 2px color-mix(in srgb, var(--accent-color) 25%, transparent);
            }
        }

        .theme-switcher__status { display: none; }
    }
}

.task-actions-menu {
  display: flex;
  align-items: center;

  .button {
    width: 44px;
    height: 44px;
    max-height: none;
    padding: 0;
  }

  &__dots {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;

    i {
      display: block;
      width: 3px;
      height: 3px;
      border-radius: 50%;
      background: currentColor;
    }
  }

  &__popup {
    position: fixed;
    z-index: 35;
    display: flex;
    flex-direction: column;
    min-width: 190px;
    padding: var(--spacer-b);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-d);
    background: var(--surface-color);
    box-shadow: var(--surface-shadow);
    animation: task-actions-menu-show .16s ease both;

    button {
      display: flex;
      align-items: center;
      gap: var(--spacer-c);
      width: 100%;
      min-height: 44px;
      padding: 0 var(--spacer-c);
      border: 0;
      border-radius: var(--border-radius-c);
      background: transparent;
      color: var(--text-color);
      cursor: pointer;
      font-size: .78rem;
      text-align: left;

      &:hover,
      &:focus-visible { background: color-mix(in srgb, var(--accent-color) 10%, transparent); outline: none; }
    }
  }

  &__delete { color: var(--due-date-overdue-color) !important; }
}

@keyframes task-actions-menu-show {
  from { opacity: 0; transform: translateY(-4px) scale(.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@media (prefers-reduced-motion: reduce) {
  .task-actions-menu__popup { animation: none; }
}

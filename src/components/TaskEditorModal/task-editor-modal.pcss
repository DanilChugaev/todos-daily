.task-editor-modal {
    &__actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: var(--spacer-c);
    }

    &__create-btn {
        flex: 1;
    }

    &__selects {
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacer-c);

        .select-field,
        .select {
            flex: 1;
        }
    }

    &__subtasks-list {
        display: flex;
        flex-direction: column;
        gap: var(--spacer-c);
    }

    &__today-button {
        align-self: flex-start;
        margin-top: calc(var(--spacer-c) * -1);
    }

    &__limit-alert {
        display: flex;
        flex-direction: column;
        gap: var(--spacer-c);
        padding: var(--spacer-d);
        border: 1px solid var(--due-date-warning-color);
        border-radius: var(--border-radius-d);
        background: color-mix(in srgb, var(--due-date-warning-color) 12%, transparent);
        color: var(--text-color);

        span {
            color: var(--muted-text-color);
            font-size: .78rem;
        }

        .button {
            align-self: flex-start;
        }
    }

    &__new-subtask {
        display: flex;
        align-items: center;

        .form-field {
            flex: 1;
        }

        .input-field__input {
            background-color: transparent;
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius-b);
            color: var(--text-color);
            cursor: pointer;
            padding: var(--spacer-c);
        }
    }
}

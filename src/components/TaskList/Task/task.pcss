.task {
    display: flex;
    align-items: stretch;
    border-radius: var(--border-radius-c);
    border: 1px solid var(--border-color);
    background-color: var(--task-bg-color);
    transition: all .3s ease;
    cursor: pointer;
    font-size: 1rem;

    &:hover {
        border-color: var(--border-color-hover);
        box-shadow: var(--box-shadow-hover);
    }

    &:focus-visible {
        outline: 2px solid var(--grab-box-shadow);
        outline-offset: 2px;
    }

    &__content {
        display: flex;
        flex-direction: column;
        gap: var(--spacer-a);
        flex: 1;
        padding: var(--spacer-d) var(--spacer-e) var(--spacer-d) 0;
        position: relative;
    }

    &__actions {
        display: flex;
        align-items: center;
        gap: var(--spacer-a);
        padding: var(--spacer-b);

        .button {
            padding: var(--spacer-b);
        }
    }

    &__info {
        display: flex;
        align-items: center;
        gap: var(--spacer-b);
        color: var(--task-info-text-color);
        font-size: 0.667rem; /*12px при base 18px*/
    }

    &__subtasks-progress {
        display: inline-flex;
        align-items: center;
        gap: var(--spacer-a);
    }

    &__due-date {
        font-weight: 500;

        &--today,
        &--tomorrow {
            color: var(--due-date-warning-color);
        }

        &--overdue {
            color: var(--due-date-overdue-color);
        }
    }

    &__progress {
        width: 100%;
        height: 3px;
        overflow: hidden;
        border-radius: 99px;
        background-color: var(--border-color);
    }

    &__progress-value {
        height: 100%;
        border-radius: inherit;
        background-color: var(--text-color);
    }

    &__icons {
        display: flex;
        flex-direction: column;
        gap: var(--spacer-a);
        position: absolute;
        top: 0;
        right: 0;
    }

    &__priority {
        position: absolute;
        top: var(--spacer-c);
        right: var(--spacer-c);
    }
}

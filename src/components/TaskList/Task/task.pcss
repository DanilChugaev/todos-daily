.task {
    display: flex;
    align-items: stretch;
    overflow: hidden;
    border-radius: var(--border-radius-d);
    border: 1px solid var(--border-color);
    background-color: var(--surface-color);
    box-shadow: var(--surface-shadow);
    transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease;
    cursor: pointer;
    font-size: 1rem;
    position: relative;

    &:hover {
        border-color: var(--border-color-hover);
        box-shadow: 0 14px 30px color-mix(in srgb, var(--text-color) 10%, transparent);
        transform: translateY(-1px);
    }

    &:focus-visible {
        outline: 2px solid var(--grab-box-shadow);
        outline-offset: 2px;
    }

    &__content {
        display: flex;
        flex-direction: column;
        gap: var(--spacer-a);
        flex: 1;
        padding: var(--spacer-d) var(--spacer-c) var(--spacer-d) 0;
        position: relative;
    }

    &__actions {
        display: flex;
        align-items: center;
        padding: var(--spacer-b);
    }

    &__info {
        flex-wrap: wrap;
        display: flex;
        align-items: center;
        gap: var(--spacer-b);
        color: var(--task-info-text-color);
        font-size: 0.667rem; /*12px при base 18px*/
    }

    &__subtasks-progress {
        display: inline-flex;
        align-items: center;
        gap: var(--spacer-a);
    }

    &__status {
        padding: 1px var(--spacer-b);
        border-radius: 99px;
        background: var(--border-color);
        font-weight: 500;

        &--inProgress {
            background: color-mix(in srgb, var(--accent-color) 16%, transparent);
            color: var(--accent-color);
        }
    }

    &__due-date {
        font-weight: 500;

        &--today,
        &--tomorrow {
            color: var(--due-date-warning-color);
        }

        &--overdue {
            color: var(--due-date-overdue-color);
        }
    }

    &__progress {
        width: 100%;
        height: 3px;
        overflow: hidden;
        border-radius: 99px;
        background-color: var(--border-color);
    }

    &__progress-value {
        height: 100%;
        border-radius: inherit;
        background-color: var(--accent-color);
    }

    &__completion-hint {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--spacer-c);
        margin-top: var(--spacer-b);
        padding: var(--spacer-c);
        border-radius: var(--border-radius-c);
        background: color-mix(in srgb, var(--accent-color) 10%, transparent);
        color: var(--muted-text-color);
        font-size: .667rem;

        .button {
            padding: 0;
            color: var(--accent-color);
            font-size: inherit;
            font-weight: 650;
        }
    }

    &__icons {
        display: flex;
        flex-direction: column;
        gap: var(--spacer-a);
        position: absolute;
        top: 0;
        right: 0;
    }

    &__priority {
        position: absolute;
        top: var(--spacer-c);
        right: 0;
    }
}

@media (hover: hover) and (pointer: fine) {
    .task__actions {
        position: absolute;
        top: var(--spacer-b);
        right: var(--spacer-b);
        z-index: 2;
        opacity: 0;
        transform: translateX(.25rem);
        transition: opacity .18s ease, transform .18s ease;
    }

    .task__priority {
        right: var(--spacer-c);
    }

    .task:hover .task__actions,
    .task:focus-within .task__actions {
        opacity: 1;
        transform: translateX(0);
    }
}

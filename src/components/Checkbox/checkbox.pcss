.checkbox {
    display: flex;
    align-items: center;
    position: relative;
    padding: var(--spacer-d);
    cursor: pointer;
    transition: opacity .18s ease, transform .18s ease;

    &:hover {
        opacity: 0.7;
        transform: scale(1.05);
    }

    &__checkbox {
        position: absolute;
        opacity: 0;
        z-index: 0;
    }

    &__icon {
        z-index: 1;
    }
}

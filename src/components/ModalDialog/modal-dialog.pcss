@import '../../styles/vars/media.pcss';

.modal-layer {
  position: fixed;
  z-index: 20;
  inset: 0;
  display: flex;
  align-items: flex-end;
  pointer-events: none;

  &--active {
    pointer-events: auto;

    .modal-dialog-backdrop {
      opacity: 1;
      background-color: var(--modal-dialog-backdrop);
    }

    .modal-dialog {
      transform: translateY(0);
    }
  }
}

.modal-dialog-backdrop {
  position: absolute;
  inset: 0;
  background-color: transparent;
  opacity: 0;
  transition: opacity .3s ease, background-color .3s ease;
}

.modal-dialog {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: min(88dvh, 50rem);
  padding: var(--spacer-d) var(--spacer-d) calc(var(--spacer-d) + env(safe-area-inset-bottom));
  border-top-left-radius: var(--border-radius-de);
  border-top-right-radius: var(--border-radius-de);
  background-color: var(--modal-dialog-bg-color);
  box-shadow: 0 -12px 32px rgba(0, 0, 0, .18);
  color: var(--modal-dialog-text-color);
  transform: translateY(100%);
  transition: transform .3s ease, opacity .3s ease;

  &__header {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacer-d);
    padding-bottom: var(--spacer-d);
  }

  &__title {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 650;
  }

  &__close-btn {
    flex: none;
    padding: var(--spacer-b);
  }

  &__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--spacer-d);
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0 var(--spacer-b) var(--spacer-b) 0;
  }

  &__confirm {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: grid;
    place-items: center;
    padding: var(--spacer-d);
    border-radius: inherit;
    background: color-mix(in srgb, var(--modal-dialog-backdrop) 82%, transparent);
  }

  &__confirm-card {
    width: min(100%, 23rem);
    padding: var(--spacer-de);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-d);
    background: var(--surface-color);
    box-shadow: var(--surface-shadow);

    h3,
    p {
      margin: 0;
    }

    h3 {
      font-size: 1rem;
      font-weight: 650;
    }

    p {
      margin-top: var(--spacer-c);
      color: var(--muted-text-color);
    }
  }

  &__confirm-actions {
    display: flex;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: var(--spacer-c);
    margin-top: var(--spacer-de);
  }
}

@media (--min-media-mobile) {
  .modal-layer {
    align-items: center;
    justify-content: center;
    padding: var(--spacer-d);
  }

  .modal-dialog {
    width: min(100%, 42rem);
    max-height: min(80dvh, 50rem);
    border-radius: var(--border-radius-de);
    opacity: 0;
    transform: translateY(1rem) scale(.98);

    .modal-layer--active & {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
}

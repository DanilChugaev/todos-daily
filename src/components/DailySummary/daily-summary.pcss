.daily-summary {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--spacer-de);
  margin: var(--spacer-d);
  padding: var(--spacer-de);
  border: 1px solid var(--border-color);
  border-radius: var(--border-radius-de);
  background: linear-gradient(135deg, color-mix(in srgb, var(--accent-color) 12%, var(--surface-color)), var(--surface-color));
  box-shadow: var(--surface-shadow);

  h1,
  p {
    margin: 0;
  }

  h1 {
    font-size: 1.2rem;
    font-weight: 650;
  }

  &__eyebrow {
    margin-bottom: var(--spacer-b) !important;
    color: var(--accent-color);
    font-size: .67rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  &__description {
    margin-top: var(--spacer-b) !important;
    color: var(--muted-text-color);
    font-size: .78rem;
  }

  &__progress {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--spacer-b);
    min-width: 5rem;

    strong {
      font-size: 1.25rem;
      font-weight: 650;
    }

    span {
      width: 100%;
      height: .35rem;
      overflow: hidden;
      border-radius: 99px;
      background: color-mix(in srgb, var(--accent-color) 15%, transparent);
    }

    i {
      display: block;
      height: 100%;
      border-radius: inherit;
      background: var(--accent-color);
      transition: width .25s ease;
    }
  }
}

@media (max-width: 420px) {
  .daily-summary {
    align-items: flex-start;
    flex-direction: column;

    &__progress {
      align-items: flex-start;
      width: 100%;
    }
  }
}

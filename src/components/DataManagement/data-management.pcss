.data-management {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--spacer-c);
  padding-top: var(--spacer-e);
  border-top: 1px solid var(--border-color);

  h3, p { margin: 0; }
  h3 { font-size: .78rem; font-weight: 650; }
  > p { color: var(--muted-text-color); font-size: .72rem; }

  &__import { display: flex; flex-direction: column; gap: var(--spacer-c); width: 100%; padding: var(--spacer-d); border: 1px solid var(--border-color); border-radius: var(--border-radius-d); background: color-mix(in srgb, var(--accent-color) 6%, transparent); font-size: .72rem; }
  &__import span { color: var(--muted-text-color); }
  &__import label { display: flex; align-items: center; gap: var(--spacer-b); }
  &__message { color: var(--muted-text-color); }
}

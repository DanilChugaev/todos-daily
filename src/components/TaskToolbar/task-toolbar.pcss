.task-toolbar {
  display: flex;
  gap: var(--spacer-c);
  padding: var(--spacer-c) var(--spacer-d) var(--spacer-d);

  &__search {
    flex: 1;
  }

  &__search input,
  &__sort select {
    width: 100%;
    min-height: 40px;
    border: 1px solid var(--border-color);
    padding: var(--spacer-c) var(--spacer-d);
    border-radius: var(--border-radius-d);
    background: var(--surface-color);
    color: var(--text-color);
    box-shadow: var(--surface-shadow);
    transition: border-color .18s ease, box-shadow .18s ease;

    &:focus {
      outline: none;
      border-color: var(--accent-color);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-color) 18%, transparent);
    }
  }

  &__sort {
    max-width: 10rem;
  }
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

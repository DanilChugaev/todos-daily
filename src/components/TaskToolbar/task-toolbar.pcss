.task-toolbar {
  display: flex;
  gap: var(--spacer-c);
  padding: var(--spacer-c) var(--spacer-d);

  &__search {
    flex: 1;
  }

  &__search input,
  &__sort select {
    width: 100%;
    min-height: 40px;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-c);
    background: var(--task-bg-color);
    color: var(--text-color);
  }

  &__sort {
    max-width: 10rem;
  }
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

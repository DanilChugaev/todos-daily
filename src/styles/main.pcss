@import './vars/media.pcss';

:root {
  color-scheme: light dark;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* {
  font-family: "Google Sans", sans-serif;
  font-weight: 400;
  font-style: normal;
  line-height: 1.2;
  box-sizing: border-box;
}

html,
body {
  height: 100%;
  margin: 0;
  padding: 0;
}

html {
  font-size: 14px;
  background: var(--bg-color);
  color: var(--text-color);
}

#root {
  display: flex;
  flex-direction: column;
  min-height: 100%;
  width: 100%;
  max-width: 1280px;
}

input, textarea, select {
  font-size: 0.7rem;
  padding: var(--spacer-c);
}

@media (--min-media-mobile) {
  html {
    font-size: 18px;
  }
}

@media (--min-media-desktop) {
  html {
    font-size: 20px;
  }

  #root {
    margin: 0 auto;
  }
}

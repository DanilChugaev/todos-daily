.new-task {
    position: sticky;
    z-index: 1;
    bottom: calc(var(--spacer-d) + env(safe-area-inset-bottom));
    margin-top: auto;
    margin-left: var(--spacer-d);
    margin-right: var(--spacer-d);
    min-height: 48px;
    border-radius: var(--border-radius-c);
    box-shadow: 0 10px 24px color-mix(in srgb, var(--accent-color) 28%, transparent);
    background-color: var(--accent-color);
    color: #f8fafc;

    &:hover {
        color: var(--button-text-color);
    }
}

.empty-list {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacer-c);
    padding: calc(var(--spacer-e) * 2) var(--spacer-d);
    text-align: center;

    &__title {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 600;
    }

    &__description {
        margin: 0;
        color: var(--task-info-text-color);
    }

    &--compact {
        margin: var(--spacer-c) var(--spacer-d);
        padding: var(--spacer-de) var(--spacer-d);
        border: 1px solid var(--border-color);
        border-radius: var(--border-radius-d);
        background: var(--surface-color);
        box-shadow: var(--surface-shadow);
    }
}

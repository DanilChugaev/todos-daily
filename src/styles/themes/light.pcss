:root,
:root[data-theme='light'] {
  color-scheme: light;
  --bg-color: #f8fafc;
  --text-color: #0f172a;
  --border-color: rgba(0, 0, 0, .1);
  --border-color-hover: rgba(0, 0, 0, .2);
  --box-shadow-hover: 0 4px 12px rgba(0, 0, 0, .08);
  --theme-switcher-radio-filter: invert(0);
  --theme-switcher-radio-filter-checked: invert(1);
  --theme-switcher-status-filter: invert(0);
  --button-bg-color: var(--text-color);
  --button-text-color: var(--bg-color);
  --button-bg-color-inverted: var(--bg-color);
  --button-text-color-inverted: var(--text-color);
  --modal-dialog-bg-color: rgb(245 247 248);
  --modal-dialog-text-color: var(--text-color);
  --modal-dialog-backdrop: rgba(0, 0, 0, .6);
  --input-border-color: rgb(from var(--bg-color) r g b / 60%);
  --input-color: var(--text-color);
  --input-color-inverted: var(--bg-color);
  --task-bg-color: rgba(240, 240, 240, .3);
  --task-info-text-color: rgb(from var(--text-color) r g b / 50%);
  --muted-text-color: #475569;
  --due-date-warning-color: #8a4b00;
  --due-date-overdue-color: #b42318;
  --grab-box-shadow: 0 0 0 2px #3b82f6;
  --grab-background-color: #eff6ff;
}
